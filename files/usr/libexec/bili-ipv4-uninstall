#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run as root.' >&2; exit 1; }
[ -r /etc/bili-ipv4/VERSION ] || { echo 'No managed bili-ipv4 installation found.' >&2; exit 1; }
umask 077
tmp=$(mktemp /tmp/bili-ipv4-uninstall.XXXXXX)
trap 'rm -f "$tmp"' EXIT
awk '
    /^# BEGIN BILI-IPV4$/ { if (inside || begins++) exit 2; inside=1; next }
    /^# END BILI-IPV4$/ { if (!inside || ends++) exit 2; inside=0; next }
    !inside { print }
    END { if (inside || begins != ends) exit 2 }
' /etc/dnsmasq.conf > "$tmp"
dnsmasq --test --conf-file="$tmp"
cat "$tmp" > /etc/dnsmasq.conf
/etc/init.d/dnsmasq restart
/etc/init.d/dnsmasq status
/etc/init.d/bili-ipv4 disable
/etc/init.d/bili-ipv4 stop
nft delete table inet bili_ipv4 2>/dev/null || :
rm -f /etc/init.d/bili-ipv4 /usr/libexec/bili-ipv4-control /usr/libexec/bili-ipv4-monitor /usr/libexec/bili-ipv4-learn.lua /usr/libexec/bili-ipv4-uninstall
rm -f /etc/bili-ipv4/domains /etc/bili-ipv4/hosts /etc/bili-ipv4/options /etc/bili-ipv4/VERSION
rmdir /etc/bili-ipv4 2>/dev/null || :
rmdir /var/run/bili-ipv4 2>/dev/null || :
echo 'Uninstalled. The original backup remains in /etc/bili-ipv4-backup/.'
